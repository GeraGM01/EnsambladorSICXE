@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid p-0">
    <!-- Tabs para opciones que tenemos -->
    <div class="row m-0">
        <div class="card-footer bg-light">
            <button class="btn btn-success" id="btnAbrirArchivo">Abrir archivo</button>
            <input type="file" id="fileInput" accept=".xe,.txt" style="display: none;" />
            <button class="btn btn-primary" id="btnPaso1">Paso 1</button>
            <button class="btn btn-primary" id="btnPaso2">Paso 2</button>
            <button class="btn btn-danger" id="btnLimpiar">Limpiar</button>
        </div>
    </div>

    <div class="row m-0 border border-dark">
        <!-- seccion pal editor de codigo -->
        <div class="col-4 p-2 border-end border-dark">
            <div class="card h-100">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">EDITOR DE CODIGO</h5>
                </div>
                <div class="card-body p-0 h-100" id="editorContainer">
                    <textarea id="editorCodigo" class="form-control border-0 h-100" rows="20" placeholder="Escribe aqui el codigo de la SICXE...."></textarea>
                </div>
            </div>
        </div>

        <div class="col-8 p-2">
            <!-- archivo intermedio -->
            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">ARCHIVO INTERMEDIO</h5>
                </div>
                <div class="card-body">
                    <div id="loadingIntermedio" class="text-center" style="display: none;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                    </div>
                    <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-bordered table-hover mb-0 table-striped" id="tablaIntermedio">
                            <thead class="table-primary">
                                <tr>
                                    <th>CP</th>
                                    <th>Bloque</th>
                                    <th>Etiqueta</th>
                                    <th>Mnemónico</th>
                                    <th>Operando</th>
                                    <th>Formato</th>
                                    <th>Error</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- la tabsim -->
                <div class="col-6">
                    <div class="card mb-3">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">TABSIM</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                                <table class="table table-sm table-bordered mb-0 table-striped" id="tablaTabsim">
                                    <thead class="table-primary">
                                        <tr>
                                            <th>Símbolo</th>
                                            <th>Dirección</th>
                                            <th>Tipo</th>
                                            <th>Bloque</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- tabla de bloques -->
                <div class="col-6">
                    <div class="card mb-3">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">TABLA DE BLOQUES</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                                <table class="table table-sm table-bordered mb-0 table-striped" id="tablaBloques">
                                    <thead class="table-primary">
                                        <tr>
                                            <th>No.</th>
                                            <th>Nombre</th>
                                            <th>Dirección</th>
                                            <th>Longitud</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">ARCHIVO .OBJ</h5>
                        </div>
                        <div class="card-body" style="min-height: 200px;">
                            <pre id="archivoObj" class="mb-0"> </pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- tipo header  -->
    <div class="row m-0">
        <div class="col p-1 bg-light border border-dark">
            <span class="small" id="statusMessage"></span>
            <span class="small float-end">Autores: <br /> <strong>> Gerardo de Jesús González Monsiváis</strong> <br /> <strong>> Jonathan Israel Loredo Palacios</strong></span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let editor;

        $(document).ready(function () {
            editor = CodeMirror.fromTextArea(document.getElementById("editorCodigo"), {
                lineNumbers: true,
                mode: "text/x-csrc",
                theme: "default",
                tabSize: 4,
                indentWithTabs: true
            });
            setTimeout(() => editor.refresh(), 100);

            $('#btnAbrirArchivo').on('click', function () {
                $('#fileInput').click();
            });

            $('#fileInput').on('change', function (e) {
                const archivo = e.target.files[0];
                if (!archivo) return;

                const lector = new FileReader();
                lector.onload = function (e) {
                    editor.setValue(e.target.result);
                    $('#statusMessage').text('Archivo cargado: ' + archivo.name);
                };
                lector.readAsText(archivo);
            });

            $('#btnPaso1').on('click', ejecutarPaso1);

            $('#btnLimpiar').on('click', function () {
                editor.setValue('');
                limpiarResultados();
                $('#statusMessage').text('Editor limpiado');
            });
        });

        function limpiarResultados() {
            $('#tablaIntermedio tbody').empty();
            $('#tablaTabsim tbody').empty();
            $('#tablaBloques tbody').empty();
            $('#archivoObj').text('');
            $('#erroresLexicosSintacticos').empty();
            $('#erroresSemanticos').empty();
        }

        function ejecutarPaso1() {
            const codigo = editor.getValue();
            if (!codigo.trim()) {
                $('#statusMessage').text('Error: No hay código para analizar.');
                return;
            }

            $('#statusMessage').text('Ejecutando Paso 1...');
            $('#loadingIntermedio').show();

            limpiarResultados();

            $.ajax({
                url: '@Url.Action("EjecutarPaso1", "Home")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(codigo),
                success: function (response) {
                    $('#loadingIntermedio').hide();

                    if (response.success) {
                        const tbodyIntermedio = $('#tablaIntermedio tbody');
                        response.listadoIntermedio.forEach(function (linea) {
                            tbodyIntermedio.append(`
                                        <tr>
                                            <td>${linea.address}</td>
                                            <td>${linea.blockNumber}</td>
                                            <td>${linea.label}</td>
                                            <td>${linea.mnemonic}</td>
                                            <td>${linea.operand}</td>
                                            <td>${linea.format}</td>
                                            <td>${linea.error}</td>
                                        </tr>
                                    `);
                        });

                        const tbodyTabsim = $('#tablaTabsim tbody');
                        response.symbolTable.forEach(function (simbolo) {
                            tbodyTabsim.append(`
                                        <tr>
                                            <td>${simbolo.symbol}</td>
                                            <td>0x${simbolo.address}</td>
                                            <td>${simbolo.type}</td>
                                            <td>${simbolo.blockNumber}</td>
                                        </tr>
                                    `);
                        });

                        const tbodyBloques = $('#tablaBloques tbody');
                        response.blockTable.forEach(function (bloque) {
                            tbodyBloques.append(`
                                        <tr>
                                            <td>${bloque.number}</td>
                                            <td>${bloque.name}</td>
                                            <td>0x${bloque.startAddress}</td>
                                            <td>0x${bloque.length}</td>
                                        </tr>
                                    `);
                        });

                        $('#statusMessage').text('Paso 1 completado. Contador de localización final: 0x' + response.finalLocctr);
                    } else {
                        $('#statusMessage').text('Error en el Paso 1: ' + response.error);
                    }
                },
                error: function (xhr, status, error) {
                    $('#loadingIntermedio').hide();
                    $('#statusMessage').text('Error al procesar el código: ' + error);
                }
            });
        }
    </script>
}
