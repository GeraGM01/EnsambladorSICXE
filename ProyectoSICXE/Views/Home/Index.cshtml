@{
    ViewData["Title"] = "Home Page";
}

@Html.Partial("_TablaArchivoIntermedio")
@Html.Partial("_TablaTabsim")
@Html.Partial("_TablaBloques")
@Html.Partial("_RegistrosObjeto")

<div class="container-fluid p-2">
    <!-- Barra de navegación responsiva -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light border mb-2">
        <div class="container-fluid flex-wrap gap-2">
            <!-- Sección Archivo -->
            <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    Archivo
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#" id="btnAbrirArchivo">Abrir archivo</a></li>
                    <li><a class="dropdown-item" href="#" id="btnGuardarIntermedio">Guardar Intermedio</a></li>
                    <li><a class="dropdown-item" href="#" id="btnGuardarTabsimBloques">Guardar TABSIM y BLOQUES</a></li>
                    <li><a class="dropdown-item" href="#" id="btnGuardarHTME">Guardar Registros</a></li>
                </ul>
            </div>

            <!-- Sección Ensamblar -->
            <div class="dropdown">
                <button class="btn btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    Ensamblar
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#" id="btnPaso1">Paso 1</a></li>
                    <li><a class="dropdown-item" href="#" id="btnPaso2">Paso 2</a></li>
                    <li><a class="dropdown-item" href="#" id="btnEjecutarAmbos">Ensamblar (Paso 1 + Paso 2)</a></li>
                </ul>
            </div>

            <!-- Botón Limpiar -->
            <button class="btn btn-outline-danger" id="btnLimpiar">Limpiar</button>
        </div>
    </nav>

    <!-- Input oculto para archivos -->
    <input type="file" id="fileInput" accept=".xe,.txt" style="display: none;" />

    <!-- Sección principal -->
    <div class="row g-2">
        <!-- Editor de código -->
        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-header bg-light">
                    <h5 class="mb-0">EDITOR DE CÓDIGO</h5>
                </div>
                <div class="card-body p-0 h-100">
                    <textarea id="editorCodigo" class="form-control border-0 h-100" rows="20" placeholder="Escribe aquí el código de la SICXE..."></textarea>
                </div>
            </div>
        </div>

        <!-- Sección de resultados -->
        <div class="col-12 col-md-8">
            <!-- Archivo Intermedio -->
            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0" data-bs-toggle="modal" data-bs-target="#modalArchivoIntermedio" style="cursor: pointer;">ARCHIVO INTERMEDIO</h5>
                </div>
                <div class="card-body">
                    <div id="loadingIntermedio" class="text-center d-none">
                        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div>
                    </div>
                    <div class="table-responsive" style="max-height: 300px;">
                        <table class="table table-bordered table-hover table-striped mb-0" id="tablaIntermedio">
                            <thead class="table-primary">
                                <tr>
                                    <th>Línea</th>
                                    <th>CP</th>
                                    <th>Bloque</th>
                                    <th>Etiqueta</th>
                                    <th>Mnemónico</th>
                                    <th>Operando</th>
                                    <th>Formato</th>
                                    <th>Error</th>
                                    <th>Código objeto</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TABSIM y Bloques -->
            <div class="row">
                <div class="col-12 col-lg-6">
                    <div class="card mb-3">
                        <div class="card-header bg-light">
                            <h5 class="mb-0" data-bs-toggle="modal" data-bs-target="#modalTabsim" style="cursor: pointer;">TABSIM</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive" style="max-height: 300px;">
                                <table class="table table-sm table-bordered table-striped mb-0" id="tablaTabsim">
                                    <thead class="table-primary">
                                        <tr>
                                            <th>Símbolo</th>
                                            <th>Dirección</th>
                                            <th>Tipo</th>
                                            <th>Bloque</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="card mb-3">
                        <div class="card-header bg-light">
                            <h5 class="mb-0" data-bs-toggle="modal" data-bs-target="#modalBloques" style="cursor: pointer;">TABLA DE BLOQUES</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive" style="max-height: 300px;">
                                <table class="table table-sm table-bordered table-striped mb-0" id="tablaBloques">
                                    <thead class="table-primary">
                                        <tr>
                                            <th>No.</th>
                                            <th>Nombre</th>
                                            <th>Dirección</th>
                                            <th>Longitud</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Registros Objeto -->
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="mb-0" data-bs-toggle="modal" data-bs-target="#modalRegistrosObjeto" style="cursor: pointer;">REGISTROS OBJETO</h5>
                        </div>
                        <div class="card-body" style="min-height: 200px; max-height: 300px; overflow-y: auto;">
                            <pre id="registrosHTME" class="mb-0"></pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer / Autores -->
    <div class="row mt-2">
        <div class="col bg-light border p-2 small">
            <span id="statusMessage"></span>
            <span class="float-end text-end d-block d-sm-inline">Autores:<br><strong>&gt; Gerardo de Jesús González Monsiváis</strong><br><strong>&gt; Jonathan Israel Loredo Palacios</strong></span>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        let editor;
        let paso1Completado = false;

        $(document).ready(function () {
            editor = CodeMirror.fromTextArea(document.getElementById("editorCodigo"), {
                lineNumbers: true,
                mode: "text/x-csrc",
                theme: "default",
                tabSize: 4,
                indentWithTabs: true
            });
            setTimeout(() => editor.refresh(), 100);

            $('#btnAbrirArchivo').on('click', function () {
                $('#fileInput').click();
            });

            $('#fileInput').on('change', function (e) {
                const archivo = e.target.files[0];
                if (!archivo) return;

                const lector = new FileReader();
                lector.onload = function (e) {
                    msj = "<p class='text-success'>¡Archivo cargado con éxito!</p> <p>Nombre del archivo: " + archivo.name + "</p>";
                    configuraDialogo("#dialogoInformativo", "Cargar archivo", msj);
                    mostrarDialogo("#dialogoInformativo");
                    editor.setValue(e.target.result);
                };
                lector.readAsText(archivo);
            });

            $('#btnPaso1').on('click', ejecutarPaso1);
            $('#btnPaso2').on('click', ejecutarPaso2);

            $('#btnLimpiar').on('click', function () {
                editor.setValue('');
                limpiarResultados();
                paso1Completado = false;
                msj = "<p class='text-success'>Editor de texto limpiado.</p>";
                configuraDialogo("#dialogoInformativo", "Limpiar editor", msj);
                mostrarDialogo("#dialogoInformativo");
                //$('#statusMessage').text('Editor limpiado');
            });

            $('#btnGuardarIntermedio').on('click', function () {
                const texto = tablaAtexto('tablaIntermedio');
                guardarComoArchivo('archivo_intermedio.txt', texto);
            });

            $('#btnGuardarTabsimBloques').on('click', function () {
                const textoTabsim = 'TABSIM:\n' + tablaAtexto('tablaTabsim');
                const textoBloques = '\n\nTABLA DE BLOQUES:\n' + tablaAtexto('tablaBloques');
                guardarComoArchivo('tabsim_bloques.txt', textoTabsim + textoBloques);
            });

            $('#btnGuardarHTME').on('click', function () {
                const texto = $('#registrosHTME').text().trim();
                guardarComoArchivo('registros_HTME.txt', texto);
            });


            $('#modalArchivoIntermedio').on('show.bs.modal', function () {
                const tabla = $('#tablaIntermedio').clone();
                tabla.removeAttr('id');
                $(this).find('.modal-body').html(tabla);
            });

            $('#modalTabsim').on('show.bs.modal', function () {
                const tabla = $('#tablaTabsim').clone();
                tabla.removeAttr('id');
                $(this).find('.modal-body').html(tabla);
            });

            $('#modalBloques').on('show.bs.modal', function () {
                const tabla = $('#tablaBloques').clone();
                tabla.removeAttr('id');
                $(this).find('.modal-body').html(tabla);
            });

            $('#modalRegistrosObjeto').on('show.bs.modal', function () {
                const tabla = $('#registrosHTME').clone();
                tabla.removeAttr('id');
                $(this).find('.modal-body').html(tabla);
            });



        });

        function limpiarResultados() {
            $('#tablaIntermedio tbody').empty();
            $('#tablaObjcode tbody').empty();
            $('#tablaTabsim tbody').empty();
            $('#tablaBloques tbody').empty();
            $('#astResult').text('');
            $('#registrosHTME').text('');
            $('#erroresLexicosSintacticos').empty();
            $('#erroresSemanticos').empty();
        }

        function ejecutarPaso1() {
            const codigo = editor.getValue();
            if (!codigo.trim()) {
                msj = "<p class='text-danger'>Error: No hay código para analizar.</p>";
                configuraDialogo("#dialogoInformativo", "Paso 1", msj);
                mostrarDialogo("#dialogoInformativo");
                //$('#statusMessage').text('Error: No hay código para analizar.');
                return;
            }

            //$('#statusMessage').text('Ejecutando Paso 1...');
            $('#loadingIntermedio').show();

            limpiarResultados();
            paso1Completado = false;

            $.ajax({
                url: '@Url.Action("EjecutarPaso1", "Home")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(codigo),
                success: function (response) {
                    $('#loadingIntermedio').hide();

                    if (response.success) {
                        paso1Completado = true;
                        const tbodyIntermedio = $('#tablaIntermedio tbody');
                        response.listadoIntermedio.forEach(function (linea, index) {
                            tbodyIntermedio.append(`
                                <tr>
                                    <td>${index + 1}</td> <!-- Número de línea -->
                                    <td>${linea.address}</td>
                                    <td>${linea.blockNumber}</td>
                                    <td>${linea.label}</td>
                                    <td>${linea.mnemonic}</td>
                                    <td>${linea.operand}</td>
                                    <td>${linea.format}</td>
                                    <td>${linea.error}</td>
                                    <td></td>
                                </tr>
                            `);
                        });


                        const tbodyTabsim = $('#tablaTabsim tbody');
                        response.symbolTable.forEach(function (simbolo) {
                            tbodyTabsim.append(`
                                        <tr>
                                            <td>${simbolo.symbol}</td>
                                            <td>0x${simbolo.address}</td>
                                            <td>${simbolo.type}</td>
                                            <td>${simbolo.blockNumber}</td>
                                        </tr>
                                    `);
                        });

                        const tbodyBloques = $('#tablaBloques tbody');
                        response.blockTable.forEach(function (bloque) {
                            tbodyBloques.append(`
                                        <tr>
                                            <td>${bloque.number}</td>
                                            <td>${bloque.name}</td>
                                            <td>0x${bloque.startAddress}</td>
                                            <td>0x${bloque.length}</td>
                                        </tr>
                                    `);
                        });

                        tbodyBloques.append(`
                            <tr class="table-info">
                                <td colspan="3"><strong>Tamaño del programa</strong></td>
                                <td><strong>0x${response.finalLocctr} bytes</strong></td>
                            </tr>
                        `);

                        msj = "<p class='text-success'>Paso 1 ejecutado con exito</p>";
                        configuraDialogo("#dialogoInformativo", "Paso 1", msj);
                        mostrarDialogo("#dialogoInformativo");
                        paso1Completado = true;
                    } else {
                        msj = "<p class='text-danger'>Ocurrió un error al ejecutar el paso 1: " + response.error + "</p>";
                        configuraDialogo("#dialogoInformativo", "Paso 1", msj);
                        mostrarDialogo("#dialogoInformativo");
                    }
                },
                error: function (xhr, status, error) {
                    $('#loadingIntermedio').hide();
                    msj = "<p class='text-danger'>Ocurrió un error al procesar el codigo: " + error + "</p>";
                    configuraDialogo("#dialogoInformativo", "Paso 1", msj);
                    mostrarDialogo("#dialogoInformativo");
                }
            });
        }

        function ejecutarPaso2() {
            return new Promise((resolve, reject) => {
                if (!paso1Completado) {
                    const msj = "<p class='text-danger'>Error: Necesitas ejecutar el Paso 1 primero.</p>";
                    configuraDialogo("#dialogoInformativo", "Paso 2", msj);
                    mostrarDialogo("#dialogoInformativo");
                    reject("Paso 1 no completado");
                    return;
                }

                $('#loadingObjcode').show();
                $('#loadingIntermedio').show();

                // Limpiar solo tablas relacionadas al Paso 2
                $('#tablaObjcode tbody').empty();
                $('#registrosHTME').text('');

                $.ajax({
                    url: '@Url.Action("EjecutarPaso2", "Home")',
                    type: 'POST',
                    contentType: 'application/json',
                    success: function (response) {
                        $('#loadingObjcode').hide();
                        $('#loadingIntermedio').hide();

                        if (response.success) {
                            const filas = $('#tablaIntermedio tbody tr');
                            response.listadoIntermedioObjCode.forEach(function (linea, index) {
                                const fila = filas.eq(index);
                                const celdas = fila.find('td');
                                let objCode = linea.objectCode;
                                if (linea.isRelocatable && objCode) {
                                    objCode += "*";
                                }
                                // Actualizar la celda de código objeto y de los errores
                                celdas.eq(8).text(objCode);
                                celdas.eq(7).text(linea.error);
                            });

                            // Mostrar los registros HTME
                            const preHTME = $('#registrosHTME');
                            response.registrosHTME.forEach(function (registro) {
                                preHTME.append(registro + '\n');
                            });

                            // Cambiar a la pestaña de OBJCODE automáticamente
                            $('#objcode-tab').tab('show');

                            msj = "<p class='text-success'>Paso 2 ejecutado con exito</p>";
                            configuraDialogo("#dialogoInformativo", "Paso 2", msj);
                            mostrarDialogo("#dialogoInformativo");
                            $('#loadingObjcode').hide();
                            $('#loadingIntermedio').hide();

                            resolve(response);
                        } else {
                            const msj = "<p class='text-danger'>Ocurrió un error en el Paso 2: " + response.error + "</p>";
                            configuraDialogo("#dialogoInformativo", "Paso 2", msj);
                            mostrarDialogo("#dialogoInformativo");
                            reject(response.error);
                        }
                    },
                    error: function (xhr, status, error) {
                        $('#loadingIntermedio').hide();
                        const msj = "<p class='text-danger'>Ocurrió un error al ejecutar el Paso 2: " + error + "</p>";
                        configuraDialogo("#dialogoInformativo", "Paso 2", msj);
                        mostrarDialogo("#dialogoInformativo");
                        reject(error);
                    }
                });
            });
        }

        $('#btnEjecutarAmbos').on('click', function () {
            ejecutarPaso1();

            const interval = setInterval(() => {
                if (paso1Completado) {
                    clearInterval(interval);
                    ejecutarPaso2().then(() => {
                                        msj = "<p class='text-success'>Ensamblado ejecutado con exito</p>";
                                        configuraDialogo("#dialogoInformativo", "Ensamblado", msj);
                                        mostrarDialogo("#dialogoInformativo");
                                        $('#loadingObjcode').hide();
                                        $('#loadingIntermedio').hide();
                    }).catch(error => {
                        // El error ya se maneja dentro de ejecutarPaso2
                    });
                }
            }, 500);
        });


        function tablaAtexto(tablaId) {
            let texto = '';
            const encabezados = $(`#${tablaId} thead tr th`).map(function () {
                return $(this).text().trim();
            }).get();
            texto += encabezados.join('\t') + '\n';

            const filas = $(`#${tablaId} tbody tr`);
            filas.each(function () {
                const columnas = $(this).find('td').map(function () {
                    return $(this).text().trim();
                }).get();
                texto += columnas.join('\t') + '\n';
            });

            return texto;
        }


        function guardarComoArchivo(nombreArchivo, contenido) {
            const blob = new Blob([contenido], { type: 'text/plain;charset=utf-8' });
            const enlace = document.createElement('a');
            enlace.href = URL.createObjectURL(blob);
            enlace.download = nombreArchivo;
            document.body.appendChild(enlace);
            enlace.click();
            document.body.removeChild(enlace);
        }

    </script>
}
