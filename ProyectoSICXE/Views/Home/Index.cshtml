@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid p-0">
    <!-- Navigation Tabs -->
    <div class="row m-0">
        <div class="card-footer bg-light">
            <button class="btn btn-success" id="btnAbrirArchivo">Abrir archivo</button>
            <input type="file" id="fileInput" accept=".xe,.txt" style="display: none;" />
            <button class="btn btn-primary" onclick="EjecutaPaso1()">Paso 1</button>
            <button class="btn btn-primary">Paso 2</button>
            <button class="btn btn-danger">Limpiar</button>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="row m-0 border border-dark">
        <!-- Code Editor Section - Left Side -->
        <div class="col-4 p-2 border-end border-dark">
            <div class="card h-100">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">EDITOR DE CODIGO</h5>
                </div>
                <div class="card-body p-0 h-100" id="editorContainer">
                    <textarea id="editorCodigo" class="form-control border-0 h-100" rows="20" placeholder="Escribe aqui el codigo de la SICXE...."></textarea>
                </div>
            </div>
        </div>

        <!-- Results Section - Right Side -->
        <div class="col-8 p-2">
            <!-- Upper Section -->
            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">ARCHIVO INTERMEDIO</h5>
                </div>
                <div class="card-body">
                    <table class="table table-bordered table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Line</th>
                                <th>Address</th>
                                <th>Label</th>
                                <th>Instruction</th>
                                <th>Operand</th>
                                <th>Object Code</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td>1000</td>
                                <td>START</td>
                                <td>LDA</td>
                                <td>#3</td>
                                <td>010003</td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td>1003</td>
                                <td></td>
                                <td>ADD</td>
                                <td>FIVE</td>
                                <td>18100F</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Lower Sections -->
            <div class="row">
                <!-- Lower Left -->
                <div class="col-6">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">TABSIM</h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm table-bordered mb-0">
                                <thead>
                                    <tr>
                                        <th>Symbol</th>
                                        <th>Address</th>
                                        <th>Type</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>START</td>
                                        <td>1000</td>
                                        <td>LABEL</td>
                                    </tr>
                                    <tr>
                                        <td>FIVE</td>
                                        <td>100F</td>
                                        <td>DATA</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Lower Right -->
                <div class="col-6">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">ARCHIVO .OBJ</h5>
                        </div>
                        <div class="card-body " style="min-height: 200px;">
                            <pre class="mb-0">Program assembled successfully.
Length: 000015
No errors detected.</pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Bar -->
    <div class="row m-0">
        <div class="col p-1 bg-light border border-dark">
            <span class="small"></span>
            <span class="small float-end">Autores: <br /> Gerardo de Jesús González Monsiváis <br /> Jonathan Israel Loredo Palacios</span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let editor;

        $(document).ready(function () {
            editor = CodeMirror.fromTextArea(document.getElementById("editorCodigo"), {
                lineNumbers: true,
                mode: "text/x-csrc",
                theme: "default",
                tabSize: 4,
                indentWithTabs: true
            });
            setTimeout(() => editor.refresh(), 100); // o usar observer si quieres precisión

            $('#btnAbrirArchivo').on('click', function () {
                $('#fileInput').click();
            });

            $('#fileInput').on('change', function (e) {
                const archivo = e.target.files[0];
                if (!archivo) return;

                const lector = new FileReader();
                lector.onload = function (e) {
                    editor.setValue(e.target.result);
                };
                lector.readAsText(archivo);
            });
        });

        function EjecutaPaso1() 
        {
            console.log("Se ejecutara el paso 1");
        }
    </script>
}
